{
  "manifest_version": 3,
  "name": "柚子樂器 EasyStore 蝦皮自動填寫",
  "version": "0.3.9",
  "description": "可靠接收商品頁交接資料，辨識蝦皮新增或更新狀態，完成 EasyStore 必填欄位後才送出。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://danny700808.github.io/play-card/*",
    "https://admin.easystore.co/products/*",
    "https://admin.easystore.co/channels/shopee/taiwan/products/sync*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://danny700808.github.io/play-card/*"
      ],
      "js": [
        "helpers.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://admin.easystore.co/products/*",
        "https://admin.easystore.co/channels/shopee/taiwan/products/sync*"
      ],
      "js": [
        "helpers.js",
        "easystore.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
