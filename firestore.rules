rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isEmployeeAuth() {
      return request.auth != null && request.auth.token.get('employee', false) == true
        && request.auth.token.get('employeeId', '') != '';
    }
    function isManagerAuth() {
      return isEmployeeAuth() && request.auth.token.get('manager', false) == true;
    }
    function employeeId() { return request.auth.token.get('employeeId', ''); }
    function ownData(data) {
      return isEmployeeAuth() && (
        data.get('employeeId', '') == employeeId() || data.get('userId', '') == employeeId() ||
        data.get('員工ID', '') == employeeId() || data.get('applicantId', '') == employeeId()
      );
    }
    function consistentOwner(data) {
      return ownData(data)
        && data.get('employeeId', employeeId()) in ['', employeeId()]
        && data.get('userId', employeeId()) in ['', employeeId()]
        && data.get('員工ID', employeeId()) in ['', employeeId()]
        && data.get('applicantId', employeeId()) in ['', employeeId()]
        && data.get('targetEmployeeId', employeeId()) in ['', employeeId()]
        && data.get('assigneeId', employeeId()) in ['', employeeId()];
    }
    function unchangedOwner() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['employeeId','userId','員工ID','applicantId','assigneeId','targetEmployeeId']);
    }
    function noReviewFields(data) {
      return !data.keys().hasAny(['approved','isApproved','approvedBy','reviewedBy','approvedAt','reviewedAt','審核人','核准人','核准時間']);
    }
    function pendingData(data) {
      return data.get('status', '待審核') in ['待審核','待主管審核','審核中','待處理','pending','已刪除','已取消','已駁回','駁回','rejected']
        && data.get('狀態', '待審核') in ['待審核','待主管審核','審核中','待處理','pending','已刪除','已取消','已駁回','駁回','rejected']
        && data.get('approvalStatus', 'pending') in ['', 'pending','待審核','rejected','已駁回']
        && data.get('reviewStatus', 'pending') in ['', 'pending','待審核','rejected','已駁回']
        && data.get('審核狀態', '待審核') in ['', 'pending','待審核','rejected','已駁回'];
    }
    function ordinaryParttime(data) {
      return data.get('status','正常') in ['正常','少於有效班段','已登記','已記錄','待審核','pending','已送出']
        && data.get('狀態','正常') in ['正常','少於有效班段','已登記','已記錄','待審核','pending','已送出']
        && data.get('approvalStatus','pending') in ['','pending','待審核'];
    }
    function ownReadCollection(collectionId) {
      return collectionId in ['employees','employeeSalaryConfigs','employeeSalaryConfigHistory','employeeSalarySettings','salaryProfiles','parttimeRecords','parttimeHourRequests','clockRecords','clockCorrections','leaveRecords','leaveRequests','temporaryAttendanceRequests','employeeSchedules','singleDaySchedules','profileChangeRequests','certificateApplications','formSubmissions'];
    }
    function requestCollection(collectionId) {
      return collectionId in ['parttimeHourRequests','clockCorrections','leaveRequests','temporaryAttendanceRequests','profileChangeRequests','certificateApplications'];
    }
    // 已知的舊版後台集合；不因瀏覽器儲存的角色字串授權。
    function isLegacyClientCollection(collectionId) {
      return collectionId in [
        // 租賃系統
        'rentalApplications',
        'rentalContracts',
        'rentalContractPeriods',
        'rentalReminderSettings',
        'rentalTemplateSettings',

        // LINE / Email / 通知佇列與提醒設定
        'notificationQueue',
        'notificationUniversal',
        'notificationSettings',
        'notificationFeatureSettings',
        'moduleNotificationSettings',
        'notificationV2Settings',
        'notificationTimeRules',
        'notificationLogs',
        'lineBindLogs',
        'lineBindingLogs',
        'employeeLineBindings',
        'manualMessages',

        // 員工 / 管理者 / 註冊 / 個資
        'employees',
        'registrationApplications',
        'admins',
        'applications',
        'teacherApplications',
        'profileChangeRequests',

        // 薪資 / 投保 / 工讀
        'employeeSalaryConfigs',
        'employeeSalaryConfigHistory',
        'salarySetup',
        'salarySettings',
        'salaryConfigs',
        'employeeSalarySettings',
        'salaryProfiles',
        'parttimeRecords',
        'parttimeHourRequests',

        // 打卡 / 請假 / 臨時出勤 / 班表
        'clockRecords',
        'clockCorrections',
        'leaveRecords',
        'leaveRequests',
        'leavePolicySettings',
        'temporaryAttendanceRequests',
        'scheduleTemplates',
        'employeeSchedules',
        'singleDaySchedules',

        // 任務 / 公告 / 教材 / 日常工作
        'tasks',
        'announcements',
        'trainingItems',
        'routines',
        'routineTemplates',

        // 系統設定 / 表格設定 / 列印模板 / 證明申請
        'systemSettings',
        'printTemplates',
        'certificateApplications',
        'certificateTemplateHistory',
        'formSettings',
        'formSubmissions',


        // 外聘老師獨立簽約系統
        'externalTeacherProfiles',
        'externalTeacherContracts',
        'externalTeacherContractTemplates',
        'externalTeacherFiles',

        // 老師合約 / 商品 / 官網商品快取
        'teacherGoods',
        'teacherGoodsInquiry',
        'contractTemplates',
        'contractLogs',
        'contracts',
        'websiteProducts',
        'officialWebsiteProducts',
        'easystoreProducts',
        'websiteGoods',
        'products',

        // 全通路營運中心
        'opsInternalProducts',
        'opsProductListingCases',
        'opsInventoryTransactions',
        'opsStoreSales',
        'opsQuickIncomes',
        'opsPurchases',
        'opsRentalLedgers',
        'opsCases',
        'opsExpenses',
        'opsSyncJobs',
        'opsAuditLogs',
        'opsInternalProductImports',
        'opsSettings',
        'opsCustomers',
        'opsPointTransactions',
        'opsReceivables',
        'opsReceivablePayments',
        'opsSalesReturns',
        'opsEducationDaily',
        'opsPlatformOrders',
        'opsPlatformSyncRuns',
        'opsPlatformSyncRequests',
        'opsPlatformInventoryQueue',
        'opsProductListingQueue'
      ];
    }

    // 交接資料：保留你原本比較收斂的規則。
    match /fengtungHandoverEntries/{entryId} {
      allow read: if isEmployeeAuth();

      allow create: if isEmployeeAuth()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if isEmployeeAuth()
        && resource.data.ownerUid == request.auth.uid;
    }

    // 管理資料只接受伺服器簽發的管理者 claims。客人連結由 Functions 驗證。
    match /{collectionId}/{document=**} {
      allow read, write: if isLegacyClientCollection(collectionId) && isManagerAuth();
    }

    match /{collectionId}/{documentId} {
      allow get: if ownReadCollection(collectionId) && isEmployeeAuth() && (
        !exists(/databases/$(database)/documents/$(collectionId)/$(documentId)) || ownData(resource.data)
      );
      allow list: if ownReadCollection(collectionId) && ownData(resource.data);
      allow create: if requestCollection(collectionId) && consistentOwner(request.resource.data)
        && pendingData(request.resource.data) && noReviewFields(request.resource.data);
      allow update: if requestCollection(collectionId) && ownData(resource.data) && unchangedOwner()
        && pendingData(resource.data) && pendingData(request.resource.data)
        && (noReviewFields(request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved','isApproved','approvedBy','reviewedBy','approvedAt','reviewedAt','審核人','核准人','核准時間']));
      allow read: if collectionId in ['announcements','trainingItems','routines','routineTemplates','scheduleTemplates','leavePolicySettings','printTemplates','formSettings'] && isEmployeeAuth();
      allow read: if collectionId == 'rentalTemplateSettings';
    }
    match /clockRecords/{documentId} {
      allow create: if consistentOwner(request.resource.data) && noReviewFields(request.resource.data)
        && request.resource.data.get('status', '') in ['正常','遲到','早退','補打卡']
        && request.resource.data.get('clockType','標準打卡') in ['標準打卡','補打卡'];
    }
    match /parttimeRecords/{documentId} {
      allow create: if consistentOwner(request.resource.data) && noReviewFields(request.resource.data) && ordinaryParttime(request.resource.data);
      allow update: if ownData(resource.data) && unchangedOwner() && ordinaryParttime(resource.data)
        && ordinaryParttime(request.resource.data) && noReviewFields(request.resource.data);
      allow delete: if ownData(resource.data) && pendingData(resource.data);
    }
    match /formSubmissions/{documentId} {
      allow create: if consistentOwner(request.resource.data) && noReviewFields(request.resource.data);
      allow update: if ownData(resource.data) && unchangedOwner() && noReviewFields(request.resource.data);
    }
    match /tasks/{documentId} {
      allow read: if isEmployeeAuth() && resource.data.get('assigneeId',resource.data.get('employeeId','')) == employeeId();
      allow update: if isEmployeeAuth() && resource.data.get('assigneeId',resource.data.get('employeeId','')) == employeeId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','狀態','completedAt','completedAtText','completedBy','updatedAt','note','employeeReply','reply','submittedAt','attachmentUrl','source']);
    }

    // 手機課務入口的綁定碼、LINE 身分、工作階段、調課與租用資料
    // 一律只能經過 Cloud Functions 驗證後存取，前端不可直接讀寫。
    match /coursePortalBindCodes/{document=**} { allow read, write: if false; }
    match /coursePortalEmailOtps/{document=**} { allow read, write: if false; }
    match /coursePortalLineLoginCodes/{document=**} { allow read, write: if false; }
    match /coursePortalLineOAuthStates/{document=**} { allow read, write: if false; }
    match /coursePortalLineSetupTokens/{document=**} { allow read, write: if false; }
    match /coursePortalRateLimits/{document=**} { allow read, write: if false; }
    match /coursePortalAccessTokens/{document=**} { allow read, write: if false; }
    match /coursePortalSessions/{document=**} { allow read, write: if false; }
    match /coursePortalTeacherBindings/{document=**} { allow read, write: if false; }
    match /coursePortalStudentBindings/{document=**} { allow read, write: if false; }
    match /coursePortalRenterBindings/{document=**} { allow read, write: if false; }
    match /coursePortalRenters/{document=**} { allow read, write: if false; }
    match /coursePortalScheduleChanges/{document=**} { allow read, write: if false; }
    match /coursePortalRoomBookings/{document=**} { allow read, write: if false; }
    match /coursePortalRoomSettings/{document=**} { allow read, write: if false; }
    match /coursePortalSubjectCatalog/{document=**} { allow read, write: if false; }
    match /coursePortalTeacherSubjectAssignments/{document=**} { allow read, write: if false; }
    match /coursePortalFeePlans/{document=**} { allow read, write: if false; }
    match /coursePortalReminderLogs/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPaymentRequests/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPeriods/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPaymentTransactions/{document=**} { allow read, write: if false; }
    match /coursePortalAttendanceRecords/{document=**} { allow read, write: if false; }
    match /coursePortalAttendanceCancellationRequests/{document=**} { allow read, write: if false; }
    match /coursePortalTeacherAttendancePayroll/{document=**} { allow read, write: if false; }
    match /coursePortalLessonContactPosts/{document=**} { allow read, write: if false; }
    // 外聘老師 V2 使用獨立集合，只允許 Admin SDK；瀏覽器端一律拒絕，舊員工公告／任務不會混入。
    match /externalTeacherAnnouncementsV2/{document=**} { allow read, write: if false; }
    match /externalTeacherAnnouncementViewsV2/{document=**} { allow read, write: if false; }
    match /externalTeacherTasksV2/{document=**} { allow read, write: if false; }
    match /externalTeacherTaskResponsesV2/{document=**} { allow read, write: if false; }
    // 舊 EXT 專用索引只供管理者查核；新版外聘工作通知只接受 employees／課務入口綁定。
    match /externalTeacherLineBindings/{document=**} { allow read, write: if isManagerAuth(); }
    // 老師身分證字號與私密附件索引只能由驗證過的 Cloud Functions 存取。
    match /teacherPrivateProfiles/{document=**} { allow read, write: if false; }
    // 老師修改中的草稿與送審快照可能含證件資料，只能由驗證過的
    // 老師／主管 Cloud Functions 存取，瀏覽器不可直接讀寫。
    match /teacherProfileDrafts/{document=**} { allow read, write: if false; }
    match /teacherProfileChangeDrafts/{document=**} { allow read, write: if false; }
    match /teacherContractPrivateSnapshots/{document=**} { allow read, write: if false; }
    // 年度合約由老師 session callable 寫入、由主管 Firebase Auth 審核；
    // 不再允許未登入瀏覽器直接把狀態改成生效。
    match /teacherContractAssignments/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractLogs/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractTemplates/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractSettings/{document=**} { allow read, write: if isManagerAuth(); }

    // 其他未知集合先不開放，避免整個資料庫完全裸開。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
