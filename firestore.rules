rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isManagerAuth() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('manager', false) == true ||
        request.auth.token.get('owner', false) == true ||
        request.auth.token.get('role', '') in ['admin', 'manager', 'owner', '主管', '管理者'] ||
        request.auth.token.get('userRole', '') in ['admin', 'manager', 'owner', '主管', '管理者'] ||
        request.auth.token.get('permissionRole', '') in ['admin', 'manager', 'owner', '主管', '管理者'] ||
        request.auth.token.get('email', '') == 'danny700808@gmail.com'
      );
    }

    // 這裡列出目前網站前端會直接讀寫的頂層集合。
    // 目的：保留租賃新系統，同時恢復員工、薪資、工讀、提醒數字、各種表格設定。
    function isClientSideOpenCollection(collectionId) {
      return collectionId in [
        // 租賃系統
        'rentalApplications',
        'rentalContracts',
        'rentalContractPeriods',
        'rentalReminderSettings',
        'rentalTemplateSettings',

        // LINE / Email / 通知佇列與提醒設定
        'notificationQueue',
        'notificationUniversal',
        'notificationSettings',
        'notificationFeatureSettings',
        'moduleNotificationSettings',
        'notificationV2Settings',
        'notificationTimeRules',
        'notificationLogs',
        'lineBindLogs',
        'lineBindingLogs',
        'employeeLineBindings',
        'manualMessages',

        // 員工 / 管理者 / 註冊 / 個資
        'employees',
        'registrationApplications',
        'admins',
        'applications',
        'teacherApplications',
        'profileChangeRequests',

        // 薪資 / 投保 / 工讀
        'employeeSalaryConfigs',
        'employeeSalaryConfigHistory',
        'salarySetup',
        'salarySettings',
        'salaryConfigs',
        'employeeSalarySettings',
        'salaryProfiles',
        'parttimeRecords',
        'parttimeHourRequests',

        // 打卡 / 請假 / 臨時出勤 / 班表
        'clockRecords',
        'clockCorrections',
        'leaveRecords',
        'leaveRequests',
        'leavePolicySettings',
        'temporaryAttendanceRequests',
        'scheduleTemplates',
        'employeeSchedules',
        'singleDaySchedules',

        // 任務 / 公告 / 教材 / 日常工作
        'tasks',
        'announcements',
        'trainingItems',
        'routines',
        'routineTemplates',

        // 系統設定 / 表格設定 / 列印模板 / 證明申請
        'systemSettings',
        'printTemplates',
        'certificateApplications',
        'certificateTemplateHistory',
        'formSettings',
        'formSubmissions',


        // 外聘老師獨立簽約系統
        'externalTeacherProfiles',
        'externalTeacherContracts',
        'externalTeacherContractTemplates',
        'externalTeacherLineBindings',
        'externalTeacherFiles',

        // 老師合約 / 商品 / 官網商品快取
        'teacherGoods',
        'teacherGoodsInquiry',
        'contractTemplates',
        'contractLogs',
        'contracts',
        'websiteProducts',
        'officialWebsiteProducts',
        'easystoreProducts',
        'websiteGoods',
        'products',

        // 全通路營運中心
        'opsInternalProducts',
        'opsInventoryTransactions',
        'opsStoreSales',
        'opsQuickIncomes',
        'opsPurchases',
        'opsRentalLedgers',
        'opsCases',
        'opsExpenses',
        'opsSyncJobs',
        'opsAuditLogs',
        'opsInternalProductImports',
        'opsSettings',
        'opsCustomers',
        'opsPointTransactions',
        'opsReceivables',
        'opsReceivablePayments',
        'opsSalesReturns',
        'opsEducationDaily',
        'opsPlatformOrders',
        'opsPlatformSyncRuns',
        'opsPlatformSyncRequests',
        'opsPlatformInventoryQueue'
      ];
    }

    // 交接資料：保留你原本比較收斂的規則。
    match /fengtungHandoverEntries/{entryId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // 合併開放：上面清單內的集合都允許前端讀寫。
    // 這一段會讓員工管理、薪資投保、工讀薪資、提醒數字、租賃系統一起恢復。
    match /{collectionId}/{document=**} {
      allow read, write: if isClientSideOpenCollection(collectionId);
    }

    // 手機課務入口的綁定碼、LINE 身分、工作階段、調課與租用資料
    // 一律只能經過 Cloud Functions 驗證後存取，前端不可直接讀寫。
    match /coursePortalBindCodes/{document=**} { allow read, write: if false; }
    match /coursePortalEmailOtps/{document=**} { allow read, write: if false; }
    match /coursePortalLineLoginCodes/{document=**} { allow read, write: if false; }
    match /coursePortalLineOAuthStates/{document=**} { allow read, write: if false; }
    match /coursePortalLineSetupTokens/{document=**} { allow read, write: if false; }
    match /coursePortalRateLimits/{document=**} { allow read, write: if false; }
    match /coursePortalAccessTokens/{document=**} { allow read, write: if false; }
    match /coursePortalSessions/{document=**} { allow read, write: if false; }
    match /coursePortalTeacherBindings/{document=**} { allow read, write: if false; }
    match /coursePortalStudentBindings/{document=**} { allow read, write: if false; }
    match /coursePortalRenterBindings/{document=**} { allow read, write: if false; }
    match /coursePortalRenters/{document=**} { allow read, write: if false; }
    match /coursePortalScheduleChanges/{document=**} { allow read, write: if false; }
    match /coursePortalRoomBookings/{document=**} { allow read, write: if false; }
    match /coursePortalRoomSettings/{document=**} { allow read, write: if false; }
    match /coursePortalReminderLogs/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPaymentRequests/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPeriods/{document=**} { allow read, write: if false; }
    match /coursePortalTuitionPaymentTransactions/{document=**} { allow read, write: if false; }
    match /coursePortalAttendanceRecords/{document=**} { allow read, write: if false; }
    match /coursePortalAttendanceCancellationRequests/{document=**} { allow read, write: if false; }
    match /coursePortalTeacherAttendancePayroll/{document=**} { allow read, write: if false; }
    match /coursePortalLessonContactPosts/{document=**} { allow read, write: if false; }
    // 老師身分證字號與私密附件索引只能由驗證過的 Cloud Functions 存取。
    match /teacherPrivateProfiles/{document=**} { allow read, write: if false; }
    match /teacherContractPrivateSnapshots/{document=**} { allow read, write: if false; }
    // 年度合約由老師 session callable 寫入、由主管 Firebase Auth 審核；
    // 不再允許未登入瀏覽器直接把狀態改成生效。
    match /teacherContractAssignments/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractLogs/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractTemplates/{document=**} { allow read, write: if isManagerAuth(); }
    match /teacherContractSettings/{document=**} { allow read, write: if isManagerAuth(); }

    // 其他未知集合先不開放，避免整個資料庫完全裸開。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
