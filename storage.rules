rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isManagerAuth() {
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('manager' in request.auth.token && request.auth.token.manager == true) ||
        ('owner' in request.auth.token && request.auth.token.owner == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'manager', 'owner', '主管', '管理者']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['admin', 'manager', 'owner', '主管', '管理者']) ||
        ('permissionRole' in request.auth.token && request.auth.token.permissionRole in ['admin', 'manager', 'owner', '主管', '管理者']) ||
        ('email' in request.auth.token && request.auth.token.email == 'danny700808@gmail.com')
      );
    }

    // 商品上架案件參考圖：只有管理者可上傳；下載網址供 AI 研究與案件預覽使用。
    match /ops-product-listing-cases/{productId}/references/{fileName} {
      allow read: if true;
      allow create, update: if isManagerAuth()
        && request.resource != null
        && request.resource.size < 8388608
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isManagerAuth();
    }

    // 手機直接拍攝的商品實體圖：與平台主圖分開保存，不經圖片加工。
    match /ops-product-listing-cases/{productId}/physical/{fileName} {
      allow read: if true;
      allow create, update: if isManagerAuth()
        && request.resource != null
        && request.resource.size < 15728640
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isManagerAuth();
    }

    // OpenAI 產生的商品圖只先作為候選圖；後端建立後，管理者可在案件中預覽與採用。
    match /ops-product-listing-cases/{productId}/generated/{fileName} {
      allow read: if true;
      allow create, update: if isManagerAuth()
        && request.resource != null
        && request.resource.size < 26214400
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isManagerAuth();
    }

    // 已在 Codex 對話完成的單次處理圖：僅管理者能寫入，發布流程可直接採用而不重跑圖片 API。
    match /ops-product-listing-cases/{productId}/completed/{fileName} {
      allow read: if true;
      allow create, update: if isManagerAuth()
        && request.resource != null
        && request.resource.size < 8388608
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isManagerAuth();
    }

    // 租賃契約附件：保留原本租賃系統使用路徑。
    match /rental-contracts/{contractId}/{fileName=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 5242880
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf' || request.resource.contentType == 'text/html');
    }

    // 外聘老師簽約附件：身分證浮水印圖、簽名圖、契約 HTML。
    match /external-teachers/{contractId}/{fileName=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 5242880
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf' || request.resource.contentType == 'text/html');
    }

    // 新老師個資頁的身分證照片只由 Cloud Functions 存取；不建立公開下載網址。
    match /teacher-private-profiles/{profileId}/{fileName=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
